{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examentracker",
  "compatibility_date": "2026-05-19",
  "main": "src/main.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "examentracker_db",
      "id": "c4f3a6f1fbc14786b8e122cd50632c78"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}